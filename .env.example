# Server Port
PORT=5000

# MongoDB Connection String (Local or MongoDB Atlas)
# Example Local: mongodb://127.0.0.1:27017/tlops
# Example Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/tlops?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/tlops

# Environment
NODE_ENV=development
